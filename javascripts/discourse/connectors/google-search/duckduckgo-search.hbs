  <form action='//duckduckgo.com' id='google-search' class='inline-form'>
    <input
      type="text"
      name="q"
      value="{{@outletArgs.searchTerm}}"
      aria-label={{i18n "search.search_google"}}
    />
    <input name="sites" value={{@outletArgs.siteUrl}} type="hidden" />
    <button class="btn btn-primary" type="submit">{{theme-i18n
        "search.search_duckduckgo_button"
      }}</button>
  </form>
